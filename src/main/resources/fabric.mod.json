{
	"schemaVersion": 1,
	"id": "hudified",
	"version": "${version}",
	"name": "hudified",
	"description": "an overlay utility mod that has most of the things you will need for a better experience in minecraft",
	"authors": [
		"Infinitygames","Keszenin"
	],
	"contributors" : ["macagooner"],
	"contact": {
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/hudified/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.swaphat.client.hudified.Hudified"],
		"modmenu": ["com.swaphat.client.hudified.compatibility.ModmenuComp"]
	},
	"mixins": [
		"hudified.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
